#!/usr/bin/env bash
#
# pre-push 钩子 —— 推送前质量门禁
#
# 仅在 `git push` 时运行，绝不在 `git commit` 时运行：
# 平时可以自由 commit 保存 WIP，只有真正要推送时才做完整校验。
#
# 运行 `make check`，与 .github/workflows/ci.yml 的 Test job 执行的是同一个目标，
# 因此「本地 pre-push 通过」即可推断「CI 的 Linux 检查也会通过」：
#   1. cargo fmt --all -- --check
#   2. cargo clippy --all-targets --all-features --locked -- -D warnings
#   3. cargo clippy --all-targets --locked -- -D warnings（默认 feature，即发布产物）
#   4. cargo test --all-features --locked
#
# 一次性启用（克隆后执行一次即可）：
#   make hooks            # 等价于 git config core.hooksPath .githooks
#
set -euo pipefail

# 定位仓库根目录，并切换过去运行（无论从哪个子目录触发 push）。
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "==> [pre-push] 开始推送前校验（make check）..."

if ! make check; then
    echo "" >&2
    echo "❌ 推送前校验失败：请根据上方输出修复后重新提交，再推送。" >&2
    echo "   格式问题可运行  cargo fmt --all  自动修复。" >&2
    echo "   推送已中止。" >&2
    exit 1
fi

echo "==> [pre-push] ✅ 全部校验通过，允许推送。"
exit 0
